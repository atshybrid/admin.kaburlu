NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Copy to .env.local and edit if needed
NEXT_PUBLIC_BACKEND_URL=https://app.kaburlumedia.com/api/v1

# Optional: if Legal/Static Pages are served by a different backend host
# (because /api/v1/tenants/{tenantId}/pages may not exist on NEXT_PUBLIC_BACKEND_URL)
NEXT_PUBLIC_PAGES_BACKEND_URL=

# Optional: override the API prefix for Legal/Static Pages routes
# Default is /api/v1. Example: /api/v1/admin
NEXT_PUBLIC_PAGES_API_PREFIX=/api/v1

# Backward-compat (older code paths)
# Tip: you may see Swagger show server as https://host/api/v1 — this app can handle that,
# but recommended value is host-only (https://host)
NEXT_PUBLIC_API_BASE=https://app.kaburlumedia.com
